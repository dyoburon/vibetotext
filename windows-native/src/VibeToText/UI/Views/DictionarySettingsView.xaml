<UserControl x:Class="VibeToText.UI.Views.DictionarySettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <Border Style="{StaticResource CardStyle}" MaxWidth="500" HorizontalAlignment="Left" Padding="24">
            <StackPanel>
                <TextBlock Text="Custom Dictionary" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                <TextBlock Text="Add words you use frequently to improve transcription accuracy. These words will be included in the Whisper prompt."
                           FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap" Margin="0,0,0,16" />

                <!-- Add word input -->
                <DockPanel Margin="0,0,0,16">
                    <Button DockPanel.Dock="Right" Content="Add"
                            Style="{StaticResource AccentButtonStyle}"
                            Margin="8,0,0,0"
                            Command="{Binding AddDictionaryWordCommand}" />
                    <TextBox Text="{Binding NewDictionaryWord, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource SettingsTextBoxStyle}"
                             Padding="12">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding AddDictionaryWordCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </DockPanel>

                <!-- Word list -->
                <ItemsControl ItemsSource="{Binding DictionaryWords}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource BgTertiaryBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="6"
                                    Padding="12,8" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding}" FontSize="13"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               VerticalAlignment="Center" />
                                    <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                            FontSize="12" Margin="6,0,0,0"
                                            Background="Transparent" BorderThickness="0"
                                            Foreground="{StaticResource TextMutedBrush}"
                                            Cursor="Hand"
                                            Command="{Binding DataContext.RemoveDictionaryWordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding DictStatusText}" FontSize="12"
                           Foreground="{StaticResource GreenBrush}" Margin="0,12,0,0" />
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
