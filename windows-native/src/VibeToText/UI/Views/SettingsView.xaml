<UserControl x:Class="VibeToText.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel MaxWidth="500" HorizontalAlignment="Left">

            <!-- Gemini API Key -->
            <Border Style="{StaticResource CardStyle}" Padding="24" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Gemini API Key" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                    <TextBlock Text="Required for Cleanup and Plan modes. Get a free key from Google AI Studio."
                               FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,16" />

                    <!-- Status indicator -->
                    <Border Background="{StaticResource BgTertiaryBrush}"
                            CornerRadius="6" Padding="12,8" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0"
                                     Fill="{Binding GeminiKeyConfigured, Converter={StaticResource BoolToVisibility}, FallbackValue=Red}">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#FF4444" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding GeminiKeyConfigured}" Value="True">
                                                <Setter Property="Fill" Value="#44BB44" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock FontSize="13" Foreground="{StaticResource TextSecondaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Not configured" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding GeminiKeyConfigured}" Value="True">
                                                <Setter Property="Text" Value="API key configured" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- API key input -->
                    <TextBox Text="{Binding GeminiApiKey, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource SettingsTextBoxStyle}"
                             Padding="12" Margin="0,0,0,12">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding SaveGeminiKeyCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>

                    <!-- Buttons -->
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Save Key"
                                Style="{StaticResource AccentButtonStyle}"
                                Margin="0,0,8,0"
                                Command="{Binding SaveGeminiKeyCommand}" />
                        <Button Content="Clear"
                                Style="{StaticResource AccentButtonStyle}"
                                Command="{Binding ClearGeminiKeyCommand}" />
                    </StackPanel>

                    <TextBlock Text="{Binding SettingsStatusText}" FontSize="12"
                               Foreground="{StaticResource GreenBrush}" Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <!-- Whisper Model -->
            <Border Style="{StaticResource CardStyle}" Padding="24" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Transcription Model" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                    <TextBlock Text="Larger models are more accurate but slower and use more memory. The model will be downloaded on first use."
                               FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,16" />

                    <ComboBox x:Name="ModelComboBox"
                              ItemsSource="{Binding AvailableWhisperModels}"
                              SelectedItem="{Binding SelectedWhisperModel}"
                              IsEnabled="{Binding IsModelChanging, Converter={StaticResource InverseBoolConverter}}"
                              SelectionChanged="ModelComboBox_SelectionChanged"
                              FontSize="14" Padding="12" Margin="0,0,0,12" />

                    <TextBlock Text="{Binding ModelStatusText}" FontSize="12"
                               Foreground="{StaticResource GreenBrush}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- Hotkey Reference -->
            <Border Style="{StaticResource CardStyle}" Padding="24">
                <StackPanel>
                    <TextBlock Text="Hotkey Reference" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Ctrl + Shift"
                                   FontSize="13" FontWeight="SemiBold" FontFamily="Consolas"
                                   Foreground="{StaticResource AccentBrush}" Margin="0,0,20,8" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Hold to record, release to transcribe"
                                   FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Alt + Shift"
                                   FontSize="13" FontWeight="SemiBold" FontFamily="Consolas"
                                   Foreground="{StaticResource AccentBrush}" Margin="0,0,20,8" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="Hold to record, cleanup via Gemini"
                                   FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Ctrl + Alt"
                                   FontSize="13" FontWeight="SemiBold" FontFamily="Consolas"
                                   Foreground="{StaticResource AccentBrush}" Margin="0,0,20,0" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Show history window"
                                   FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
