<UserControl x:Class="VibeToText.UI.Views.HistoryListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Converters are in App.xaml resources -->

    <Grid>
        <!-- Empty state -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding HasEntries, Converter={StaticResource InverseBoolToVisibility}}">
            <TextBlock Text="&#xE720;" FontFamily="Segoe MDL2 Assets" FontSize="48"
                       Foreground="{StaticResource TextMutedBrush}"
                       HorizontalAlignment="Center" Opacity="0.3" Margin="0,0,0,20" />
            <TextBlock Text="No transcriptions yet"
                       Foreground="{StaticResource TextMutedBrush}" FontSize="14"
                       HorizontalAlignment="Center" />
            <Border Background="{StaticResource BgSecondaryBrush}" CornerRadius="6"
                    Padding="16,8" Margin="0,8,0,0" HorizontalAlignment="Center">
                <TextBlock Text="ctrl+shift to record"
                           Foreground="{StaticResource TextMutedBrush}" FontSize="12"
                           FontFamily="Consolas" />
            </Border>
        </StackPanel>

        <!-- Content -->
        <DockPanel Visibility="{Binding HasEntries, Converter={StaticResource BoolToVisibility}}">
            <!-- Common words section -->
            <Border DockPanel.Dock="Top" Padding="16"
                    Background="{StaticResource BgSecondaryBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <StackPanel>
                    <TextBlock Text="TOP WORDS" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10" />
                    <ItemsControl ItemsSource="{Binding CommonWords}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource WordChipStyle}" Margin="0,0,6,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Word}" FontSize="12" FontWeight="Medium"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding Count}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentBrush}" Margin="5,0,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Entries list -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,12,12,0">
                <ItemsControl ItemsSource="{Binding Entries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource EntryCardStyle}">
                                <StackPanel>
                                    <!-- Header: time + mode badge -->
                                    <DockPanel Margin="0,0,0,10">
                                        <TextBlock Text="{Binding RelativeTime}"
                                                   FontSize="11" FontWeight="Medium"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   VerticalAlignment="Center" />
                                        <Border DockPanel.Dock="Right"
                                                Style="{StaticResource ModeBadgeStyle}"
                                                Background="{Binding Mode, Converter={StaticResource ModeBackgroundConverter}}">
                                            <TextBlock Text="{Binding Mode}"
                                                       FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{Binding Mode, Converter={StaticResource ModeForegroundConverter}}" />
                                        </Border>
                                    </DockPanel>

                                    <!-- Text (selectable + copyable) -->
                                    <TextBox Text="{Binding Text, Mode=OneWay}"
                                             FontSize="14" TextWrapping="Wrap"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             IsReadOnly="True"
                                             MaxHeight="100"
                                             Padding="0"
                                             Cursor="IBeam" />

                                    <!-- Stats -->
                                    <TextBlock Text="{Binding StatsText}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
