<UserControl x:Class="VibeToText.UI.Views.MicrophoneSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <Border Style="{StaticResource CardStyle}" MaxWidth="500" HorizontalAlignment="Left" Padding="24">
            <StackPanel>
                <TextBlock Text="Audio Input Device" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                <TextBlock Text="Select the microphone to use for voice recording."
                           FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap" Margin="0,0,0,16" />

                <ComboBox ItemsSource="{Binding AudioDevices}"
                          SelectedIndex="{Binding SelectedDeviceIndex}"
                          Style="{StaticResource SettingsComboBoxStyle}"
                          DisplayMemberPath="Name">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>

                <TextBlock Text="{Binding MicStatusText}" FontSize="12"
                           Foreground="{StaticResource GreenBrush}" Margin="0,12,0,0" />
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
